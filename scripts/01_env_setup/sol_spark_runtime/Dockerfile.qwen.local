FROM nvcr.io/nvidia/pytorch:25.11-py3@sha256:417cbf33f87b5378849df37983552cd1f8bc8b62fe1ceabe004de816a55dff21
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY ComfyUI /opt/ComfyUI
RUN test "$(git -C /opt/ComfyUI rev-parse HEAD)" = "b1693ecba9f5b65f8c80ab36b195ab963ec92413"
RUN python -c "import importlib.metadata as m; from pathlib import Path; Path('/tmp/torch-constraints.txt').write_text('\n'.join(n+'=='+m.version(n) for n in ['torch','torchvision'])+'\n')"
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked sed -E '/^(torch|torchvision|torchaudio)([<=>~! ].*)?$/d; /^comfyui-(frontend-package|workflow-templates|embedded-docs)==/d' /opt/ComfyUI/requirements.txt > /tmp/comfy-requirements.txt  && python -m pip install --index-url https://mirrors.aliyun.com/pypi/simple -c /tmp/torch-constraints.txt -r /tmp/comfy-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked python -m pip install --no-deps --index-url https://mirrors.aliyun.com/pypi/simple torchaudio==2.9.1
RUN python -c "import torch, torchvision, torchaudio; print(torch.__version__, torchvision.__version__, torchaudio.__version__)"
WORKDIR /opt/ComfyUI
ENTRYPOINT []
CMD ["python"]
