{
  "plan_fingerprint": "7510ba9e055f1db657fcdd73ea1716d8859c7a814d3efcb43c887c3e1a32364e",
  "source_film_sha256": "a52f16cb1e0effe20c9aaf73dcf863c3f6903b8e10b2ec79c6193ab1a753b92c",
  "sample_rate": 32000,
  "film_samples": 2920000,
  "cues": [
    {
      "id": "N01",
      "text": "西农以献礼为名，取得了特洛伊人的信任。城门，就这样向木马敞开。",
      "audio_sha256": "ad3b9d79dcecec248b474432e4a1fa745ab640cb9c94854a84ac031f1ab39f21",
      "start_sample": 19200,
      "end_sample": 216105,
      "start_s": 0.6,
      "end_s": 6.75328125,
      "duration_s": 6.15328125,
      "latest_end_s": 9.6,
      "time_stretch": 1.0
    },
    {
      "id": "N02",
      "text": "木轮越过门槛。特洛伊人亲手，把藏着伏兵的木马拖进城中。",
      "audio_sha256": "ce7326885a4fd72c5c2c6428de084544da848a204c3240f9bdc100e1ec2ad4e9",
      "start_sample": 339200,
      "end_sample": 516787,
      "start_s": 10.6,
      "end_s": 16.14959375,
      "duration_s": 5.54959375,
      "latest_end_s": 19.7,
      "time_stretch": 1.0
    },
    {
      "id": "N03",
      "text": "暮色降临，城门落闩。木马留在广场，人们卸下了戒备。",
      "audio_sha256": "aed61e98a3b2c2c627057c6a8237d431f4536582bb65c569475f25b42295a0bb",
      "start_sample": 672000,
      "end_sample": 868905,
      "start_s": 21.0,
      "end_s": 27.15328125,
      "duration_s": 6.15328125,
      "latest_end_s": 29.5,
      "time_stretch": 1.0
    },
    {
      "id": "N04",
      "text": "夜色深处，木马的舱口悄然开启。奥德修斯探出身来。",
      "audio_sha256": "4083a5cc2e09202cad131c3b11c8ea5842c484ca5b1a0db601f0c58cb3a95b1e",
      "start_sample": 979200,
      "end_sample": 1151585,
      "start_s": 30.6,
      "end_s": 35.98703125,
      "duration_s": 5.38703125,
      "latest_end_s": 39.7,
      "time_stretch": 1.0
    },
    {
      "id": "N05",
      "text": "他沿木梯下行，向同伴发出信号。伏兵一个接一个，踏上特洛伊的石路。",
      "audio_sha256": "c22b783afb1f7be7c4a94331a2de80b85434b41d2395abd6f0c3ce148cd400b9",
      "start_sample": 1353600,
      "end_sample": 1575026,
      "start_s": 42.3,
      "end_s": 49.2195625,
      "duration_s": 6.9195625,
      "latest_end_s": 54.0,
      "time_stretch": 1.0
    },
    {
      "id": "N06",
      "text": "六人小队，直逼城门。",
      "audio_sha256": "cb5cf89b71241edbe5693754fc10f954de5ef95173bb5707a1e1d19c7769bd12",
      "start_sample": 1760000,
      "end_sample": 1829475,
      "start_s": 55.0,
      "end_s": 57.17109375,
      "duration_s": 2.17109375,
      "latest_end_s": 59.4,
      "time_stretch": 1.0
    },
    {
      "id": "N07",
      "text": "守军拦路，夺门之战爆发。",
      "audio_sha256": "f62d58371cef6e45f9c2f9bcb50cde4c1fc4a46183f7802a0d3efe85f570adcd",
      "start_sample": 1920000,
      "end_sample": 1999506,
      "start_s": 60.0,
      "end_s": 62.4845625,
      "duration_s": 2.4845625,
      "latest_end_s": 64.4,
      "time_stretch": 1.0
    },
    {
      "id": "N08",
      "text": "剑矛相接，伏兵抢进门前。",
      "audio_sha256": "6097165da356913324b925a37812b88cd6148a246457e3d28b04fdb1f0da4077",
      "start_sample": 2080000,
      "end_sample": 2157277,
      "start_s": 65.0,
      "end_s": 67.41490625,
      "duration_s": 2.41490625,
      "latest_end_s": 69.4,
      "time_stretch": 1.0
    },
    {
      "id": "N09",
      "text": "同伴拼死掩护，两人抬起门闩。",
      "audio_sha256": "12bcc3b933dd1dd4150ac433c4db5a1e4b6f867c26f0f4c405d2c95738d38074",
      "start_sample": 2240000,
      "end_sample": 2346627,
      "start_s": 70.0,
      "end_s": 73.33209375,
      "duration_s": 3.33209375,
      "latest_end_s": 74.3,
      "time_stretch": 1.0
    },
    {
      "id": "N10",
      "text": "城外，阿伽门农举剑待命。城门，终于打开。",
      "audio_sha256": "d30284ba7c1aed5185259a3786c8de5efdf5ac9ddae66b78338ae728370b8e13",
      "start_sample": 2390400,
      "end_sample": 2548668,
      "start_s": 74.7,
      "end_s": 79.645875,
      "duration_s": 4.945875,
      "latest_end_s": 81.1,
      "time_stretch": 1.0
    },
    {
      "id": "N11",
      "text": "希腊军团涌入，与守军迎面交锋。",
      "audio_sha256": "417dbb4f3bffb71980e9b6ef60d5dee270f6b882118cb5b676692e6aa360a5a8",
      "start_sample": 2608000,
      "end_sample": 2709425,
      "start_s": 81.5,
      "end_s": 84.66953125,
      "duration_s": 3.16953125,
      "latest_end_s": 85.9,
      "time_stretch": 1.0
    },
    {
      "id": "N12",
      "text": "木马计得手，决战才刚开始。",
      "audio_sha256": "3e4861a8e0840f58771650c5005f0011f83631cf7b0b02b3e293b8613dac4d88",
      "start_sample": 2771200,
      "end_sample": 2870025,
      "start_s": 86.6,
      "end_s": 89.68828125,
      "duration_s": 3.08828125,
      "latest_end_s": 91.1,
      "time_stretch": 1.0
    }
  ],
  "time_stretch_applied": false,
  "overlaps": false
}
