    },
    {
      "id": "N12",
      "start_s": 86.6,
      "latest_end_s": 91.1,
      "text": "木马计得手，决战才刚开始。",
      "speed": 1.06,
      "text_sha256": "0ebcf664840d5c2e894b2b76977c19e39f414f4cd4809a7a2448d45055ced874",
