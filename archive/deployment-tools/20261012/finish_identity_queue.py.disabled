#!/usr/bin/env python3
"""Finish the active MSR trial, render improved workflow films, restore video serving."""
import json
import os
from pathlib import Path
import subprocess
import time
R=Path('/home/admin/sol-spark-runtime');D=R/'identity_tests_20261003'
env=dict(os.environ,SOL_H3_SPARK_RUNTIME_ROOT=str(R),CUDA_VISIBLE_DEVICES='0',
 CUDA_HOME='/usr/local/cuda',CPATH=str(R/'sysroot/usr/include/python3.12')+':'+str(R/'sysroot/usr/include'),
 PATH='/home/admin/.local/bin:/usr/local/cuda/bin:'+os.environ.get('PATH',''),OMP_NUM_THREADS='1',
 HF_HUB_OFFLINE='1',TRANSFORMERS_OFFLINE='1',TORCHINDUCTOR_COMPILE_THREADS='1',
 PYTHONPATH=str(R),PYTHONUNBUFFERED='1')
try:
 deadline=time.monotonic()+900
 while any(Path(f'/proc/{pid}').exists() for pid in (1915555,1916422)):
  if time.monotonic()>deadline:raise TimeoutError('Previous owned video workers still running')
  time.sleep(5)
 if not (D/'msr/result.json').exists():
  with (D/'msr_retry.log').open('ab') as log:
   subprocess.run([str(R/'stage2-env/bin/python'),str(R/'run_ltx_identity_trial.py'),'--method','msr'],
    env=env,stdout=log,stderr=log,check=True)
 print('MSR_COMPLETE',flush=True)
 with (D/'optimized_workflows.log').open('ab') as log:
  subprocess.run([str(R/'stage2-env/bin/torchrun'),'--standalone','--nproc-per-node=1',
   str(R/'refine_identity_workflows.py')],env=env,stdout=log,stderr=log,check=True)
 print('OPTIMIZED_WORKFLOWS_COMPLETE',flush=True)
finally:
 with (D/'restored_fl_server_v2.log').open('ab') as log:
  server=subprocess.Popen([str(R/'start_sol_server.sh')],stdout=log,stderr=log,stdin=subprocess.DEVNULL,
   env=dict(env,SOL_TASK='fl2va',SOL_PATHS_FILE=str(R/'paths.json')),start_new_session=True)
 (D/'restored_fl_server.pid').write_text(str(server.pid))
 print(json.dumps(dict(status='VIDEO_SERVICE_RESTARTING',pid=server.pid)),flush=True)
